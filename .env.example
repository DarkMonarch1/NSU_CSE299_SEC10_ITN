# CareerSetu — Environment Configuration
# Copy this file to .env and fill in values for your deployment.

# JWT secret key — CHANGE THIS in production!
JWT_SECRET_KEY=careersetu-dev-secret-code-1223

# JWT token expiry in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# Database URL
# For local development: sqlite:///./careersetu.db
# For Railway deployment: Railway will provide PostgreSQL DATABASE_URL automatically
# For manual PostgreSQL: postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///./careersetu.db

# ML microservice URL (for docker-compose / split deployments)
ML_SERVICE_URL=http://localhost:8001

# CORS allowed origins (comma-separated for multiple)
# For local development: http://localhost:3000
# For Railway deployment: https://careersetu-frontend.up.railway.app,https://careersetu.up.railway.app
CORS_ORIGINS=http://localhost:3000
