# CareerSetu — Environment Configuration
# Copy this file to .env and fill in values for your deployment.

# JWT secret key — CHANGE THIS in production!
JWT_SECRET_KEY=careersetu-dev-secret-change-in-production

# JWT token expiry in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# SQLite database URL (the Compose deployment stores this under its named volume)
DATABASE_URL=sqlite:////data/careersetu.db

# ML microservice URL (for docker-compose / split deployments)
ML_SERVICE_URL=http://localhost:8001

# CORS allowed origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:3000
