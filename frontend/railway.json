{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  },
  "variables": {
    "NEXT_PUBLIC_API_URL": "https://careersetu.up.railway.app",
    "NODE_ENV": "production"
  }
}